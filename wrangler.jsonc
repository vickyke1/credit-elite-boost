{
  // Cloudflare Workers static-assets deployment for the Vite build output.
  // Explicit config means Wrangler skips its Vite 6+ auto-setup.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "credit-elite-boost",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths serve index.html so React Router handles direct links and refreshes.
    "not_found_handling": "single-page-application"
  }
}
