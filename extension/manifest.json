{
  "manifest_version": 3,
  "name": "Credit Elite Boost",
  "version": "1.0.0",
  "description": "Quick credit-utilization calculator and one-click access to the Credit Elite Boost tradeline marketplace, calculator, and guides.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Credit Elite Boost",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://cpncreditboost.com/*"]
}
