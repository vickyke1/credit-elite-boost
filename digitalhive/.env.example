# DigitalHive environment variables
# Copy this file to .env.local and fill in your values.

# Public site URL (used for SEO, sitemap, canonical URLs, Open Graph)
NEXT_PUBLIC_SITE_URL=https://digitalhive.com

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (the content value of the meta tag)
NEXT_PUBLIC_GSC_VERIFICATION=

# Admin dashboard passcode (client-side gate for the demo admin area)
NEXT_PUBLIC_ADMIN_PASSCODE=digitalhive-admin
